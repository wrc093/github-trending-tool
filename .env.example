# 飞书自定义机器人 Webhook 地址（必填）
# 在飞书群聊中添加自定义机器人后获取
FEISHU_WEBHOOK_URL=

# 飞书签名校验密钥（可选，若机器人开启了签名校验则必填）
FEISHU_SECRET=

# 是否启用 LLM 总结（默认 false，使用纯模板拼接）
LLM_ENABLED=false

# LLM API 配置（LLM_ENABLED=true 时生效，支持 OpenAI 兼容接口）
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Tavily 网页搜索 API 配置
# 注册获取：https://tavily.com
TAVILY_API_KEY=

# Trending 爬取配置
# 按语言过滤，留空则爬取全部（例如填 python 只爬 Python 榜）
TRENDING_LANGUAGE=

# 总结时取前 N 个仓库
TRENDING_TOP_N=25

# 请求超时时间（秒）
TRENDING_TIMEOUT=30
